{
  "name": "visit-kchr-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prepare": "husky install",
    "docker:build": "docker build . -f ./Dockerfile --no-cache -t visit-kchr-frontend",
    "docker:run": "docker run -d --restart always -p 8100:80 --env-file .env.local visit-kchr-frontend:latest"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@fontsource-variable/montserrat": "^5.1.0",
    "@fontsource-variable/oswald": "^5.1.0",
    "@mui/icons-material": "^5.14.19",
    "@mui/material": "^5.14.19",
    "@mui/x-date-pickers": "^6.19.0",
    "@pbe/react-yandex-maps": "^1.2.5",
    "@react-pdf/renderer": "^4.2.2",
    "@reduxjs/toolkit": "^1.9.5",
    "@types/swiper": "^6.0.0",
    "async-mutex": "^0.4.0",
    "axios": "^1.3.6",
    "dayjs": "^1.11.7",
    "file-saver": "^2.0.5",
    "formik": "^2.4.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-input-mask": "^2.0.4",
    "react-redux": "^8.0.5",
    "react-router-dom": "^6.10.0",
    "react-toastify": "^9.1.2",
    "react-use-draggable-scroll": "^0.4.7",
    "sjs-base-model": "^2.0.1",
    "swiper": "^11.2.4",
